+//! Native temporary storage for the local portable edition.
+use std::path::PathBuf;
+
+/// Use the executable's Data/Temp when a portable marker is present; fail locally on write errors.
+pub fn temp_dir() -> std::io::Result<PathBuf> {
+    if let Ok(exe) = std::env::current_exe()
+        && let Some(parent) = exe.parent()
+        && (parent.join("portable.txt").is_file() || parent.join("PdfCraft.portable").is_file() || parent.join("PDF.portable").is_file())
+    {
+        let dir = parent.join("Data").join("Temp");
+        std::fs::create_dir_all(&dir)?;
+        return Ok(dir);
+    }
+    Ok(std::env::temp_dir())
+}
