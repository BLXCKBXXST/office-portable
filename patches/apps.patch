@@ -0,0 +1,72 @@
+//! Native portable storage selected by a marker beside the executable.
+use std::path::{Path, PathBuf};
+
+/// A portable copy keeps its data with its executable, independent of the working directory.
+/// Keep this path even when it is not writable: falling back would leak data into AppData.
+pub fn data_dir() -> Option<PathBuf> {
+    data_dir_for_exe(&std::env::current_exe().ok()?)
+}
+
+fn data_dir_for_exe(exe: &Path) -> Option<PathBuf> {
+    let parent = exe.parent()?;
+    parent.join("portable.txt").is_file().then(|| parent.join("Data"))
+}
+
+/// A named part of the portable profile; absent when portable mode is off.
+pub fn section(name: &str) -> Option<PathBuf> {
+    section_for_exe(&std::env::current_exe().ok()?, name)
+}
+
+fn section_for_exe(exe: &Path, name: &str) -> Option<PathBuf> {
+    data_dir_for_exe(exe).map(|p| p.join(name))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    #[test]
+    fn sections_follow_the_executable_and_never_fall_back_to_appdata() {
+        let dir = directory();
+        let exe = dir.join("Custom Name.exe");
+        assert_eq!(section_for_exe(&exe, "Settings"), None);
+        std::fs::write(dir.join("portable.txt"), b"").unwrap();
+        // A file blocks Data: still return local paths, never a per-user fallback.
+        std::fs::write(dir.join("Data"), b"blocked").unwrap();
+        for section in ["Settings", "User", "Cache", "Logs", "Recovery", "Runtime", "Temp"] {
+            assert_eq!(section_for_exe(&exe, section), Some(dir.join("Data").join(section)));
+        }
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+
+    fn directory() -> PathBuf {
+        static NEXT: AtomicUsize = AtomicUsize::new(0);
+        let dir = std::env::temp_dir().join(format!("craft-portable-{}-{}", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed)));
+        std::fs::create_dir_all(&dir).unwrap();
+        dir
+    }
+
+    #[test]
+    fn marker_redirects_gui_and_cli_beside_executable() {
+        let dir = directory();
+        std::fs::write(dir.join("portable.txt"), b"portable").unwrap();
+        for name in ["app.exe", "app-cli.exe"] {
+            assert_eq!(data_dir_for_exe(&dir.join(name)), Some(dir.join("Data")));
+        }
+        // Resolution must not create data or fall back when the destination is unusable.
+        assert!(!dir.join("Data").exists());
+        std::fs::write(dir.join("Data"), b"not a directory").unwrap();
+        assert_eq!(data_dir_for_exe(&dir.join("app.exe")), Some(dir.join("Data")));
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+
+    #[test]
+    fn absent_marker_or_marker_directory_preserves_normal_storage() {
+        let dir = directory();
+        assert_eq!(data_dir_for_exe(&dir.join("app.exe")), None);
+        std::fs::create_dir(dir.join("portable.txt")).unwrap();
+        assert_eq!(data_dir_for_exe(&dir.join("app.exe")), None);
+        std::fs::remove_dir_all(dir).unwrap();
+    }
+}
